<label>Semilla reproducible</label>
<input id="seed" type="number" value="20260930">
</div>
<div class="control">
<label>Ventaja local %</label>
<input id="homeAdv" type="number" step=".1" value="3.5">
</div>
</div>

<div class="actions" style="margin-top:12px">
<div class="control">
<button class="primary" id="run">▶ Ejecutar simulación por fases</button>
</div>
<div class="control">
<button id="clear">Limpiar entradas</button>
</div>
</div>

<div id="status" class="status">
Sistema listo. Modelo escalonado Abridor/Bullpen activo.
</div>

</header>

<section class="panel">

<h2>⚾ Selección de Equipos y Control de Lanzadores</h2>

<div class="teams">

<!-- LOCAL -->
<div class="team-panel local">
<div class="team-head"><h3>Equipo local</h3><span class="badge">LOCAL</span></div>
<div class="metrics">
<div style="grid-column: span 2">
  <label>Seleccionar Equipo Oficial (Local)</label>
  <select id="selectA"><option value="">-- Elige un equipo --</option></select>
</div>
<div><label>Nombre</label><input id="m_nombreA"></div>
<div><label>Carreras / juego *</label><input id="m_rA" type="number" step=".01"></div>
<div><label>Carreras permitidas / juego</label><input id="m_raA" type="number" step=".01"></div>
<div><label>OPS</label><input id="m_opsA" type="number" step=".001"></div>
<div><label>HR / juego</label><input id="m_hrA" type="number" step=".01"></div>
