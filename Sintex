 {nombre: "Boston Red Sox", r: 4.25, ra: 4.21, ops: 0.716, hr: 1.01, k: 21.7, bb: 8.5, era: 4.05, bull: 4.28, def: 0.981},
 {nombre: "Arizona Diamondbacks", r: 4.56, ra: 4.41, ops: 0.720, hr: 1.02, k: 19.4, bb: 8.8, era: 4.15, bull: 4.58, def: 0.982},
 {nombre: "Cleveland Guardians", r: 4.19, ra: 3.82, ops: 0.696, hr: 0.99, k: 20.8, bb: 9.4, era: 3.58, bull: 3.99, def: 0.986},
 {nombre: "Chicago White Sox", r: 4.79, ra: 4.08, ops: 0.726, hr: 1.27, k: 24.1, bb: 9.5, era: 3.78, bull: 4.25, def: 0.983},
 {nombre: "Pittsburgh Pirates", r: 4.73, ra: 4.22, ops: 0.734, hr: 1.15, k: 22.0, bb: 8.0, era: 3.95, bull: 4.39, def: 0.982},
 {nombre: "Houston Astros", r: 4.53, ra: 4.35, ops: 0.733, hr: 1.40, k: 21.9, bb: 8.7, era: 4.08, bull: 4.29, def: 0.984},
 {nombre: "Texas Rangers", r: 4.15, ra: 4.49, ops: 0.705, hr: 0.98, k: 21.6, bb: 8.2, era: 4.18, bull: 4.62, def: 0.981},
 {nombre: "Miami Marlins", r: 4.41, ra: 4.18, ops: 0.726, hr: 1.04, k: 22.8, bb: 7.1, era: 3.88, bull: 4.38, def: 0.982},
 {nombre: "Baltimore Orioles", r: 4.46, ra: 4.55, ops: 0.711, hr: 1.24, k: 25.0, bb: 9.6, era: 4.31, bull: 4.69, def: 0.980},
 {nombre: "Toronto Blue Jays", r: 4.00, ra: 4.45, ops: 0.688, hr: 0.92, k: 20.8, bb: 8.4, era: 4.15, bull: 4.61, def: 0.983},
 {nombre: "Washington Nationals", r: 5.07, ra: 4.62, ops: 0.744, hr: 1.30, k: 23.0, bb: 7.4, era: 4.39, bull: 4.82, def: 0.980},
 {nombre: "Minnesota Twins", r: 4.56, ra: 4.39, ops: 0.720, hr: 1.15, k: 21.4, bb: 7.9, era: 4.11, bull: 4.58, def: 0.982},
 {nombre: "St. Louis Cardinals", r: 4.44, ra: 4.36, ops: 0.691, hr: 1.03, k: 20.2, bb: 8.1, era: 4.12, bull: 4.48, def: 0.983},
 {nombre: "Detroit Tigers", r: 4.46, ra: 4.32, ops: 0.720, hr: 1.12, k: 22.9, bb: 9.5, era: 4.02, bull: 4.49, def: 0.984},
 {nombre: "Seattle Mariners", r: 4.10, ra: 4.18, ops: 0.702, hr: 1.01, k: 23.9, bb: 7.6, era: 3.91, bull: 4.32, def: 0.985},
 {nombre: "Cincinnati Reds", r: 4.11, ra: 4.58, ops: 0.699, hr: 1.31, k: 25.5, bb: 9.2, era: 4.35, bull: 4.75, def: 0.981},
 {nombre: "New York Mets", r: 4.31, ra: 4.55, ops: 0.705, hr: 1.26, k: 21.8, bb: 7.8, era: 4.28, bull: 4.72, def: 0.981},
 {nombre: "Kansas City Royals", r: 4.26, ra: 4.72, ops: 0.718, hr: 1.05, k: 20.9, bb: 8.4, era: 4.48, bull: 4.95, def: 0.979},
 {nombre: "San Francisco Giants", r: 4.13, ra: 4.78, ops: 0.706, hr: 1.10, k: 23.5, bb: 7.2, era: 4.55, bull: 4.98, def: 0.978},
 {nombre: "Oakland Athletics", r: 4.31, ra: 4.98, ops: 0.719, hr: 1.20, k: 22.4, bb: 8.5, era: 4.79, bull: 5.21, def: 0.977},
 {nombre: "Los Angeles Angels", r: 4.04, ra: 5.12, ops: 0.679, hr: 0.91, k: 25.5, bb: 8.4, era: 4.86, bull: 5.29, def: 0.976},
 {nombre: "Colorado Rockies", r: 4.64, ra: 5.61, ops: 0.739, hr: 1.11, k: 22.8, bb: 8.1, era: 5.38, bull: 5.88, def: 0.975}
];

let rngState = 20260930;
const $ = id => document.getElementById(id);

function initSelects(){
 const selA = $("selectA"); const selB = $("selectB");
 MLB_DATA.sort((a,b)=>a.nombre.localeCompare(b.nombre)).forEach(t => {
  const oA = document.createElement("option"); oA.value = t.nombre; oA.textContent = t.nombre; selA.appendChild(oA);
  const oB = document.createElement("option"); oB.value = t.nombre; oB.textContent = t.nombre; selB.appendChild(oB);
 });
}

function applyTeam(teamName, side){
 const team = MLB_DATA.init ? null : MLB_DATA.find(t => t.nombre === teamName);
 if(!team) return;
 $("m_nombre" + side).value = team.nombre;
 $("m_r" + side).value = team.r;
 $("m_ra" + side).value = team.ra;
 $("m_ops" + side).value = team.ops;
 $("m_hr" + side).value = team.hr;
 $("m_k" + side).value = team.k;
 $("m_bb" + side).value = team.bb;
 $("m_era" + side).value = team.era;
 $("m_bull" + side).value = team.bull;
 $("m_def" + side).value = team.def;
 $("altEra" + side).value = "";
}

$("selectA").onchange = (e) => applyTeam(e.target.value, "A");
$("selectB").onchange = (e) => applyTeam(e.target.value, "B");

function val(id){ const n = Number($(id)?.value); return Number.isFinite(n) ? n : null; }
function nm(id){ return $(id)?.value?.trim() || ""; }
function clamp(x,a,b){ return Math.max(a, Math.min(b, x)); }
function pct(x){ return (100 * x).toFixed(2) + "%"; }
function rec(m, k){ m[k] = (m[k] || 0) + 1; }

function topN(m, N, n=10){
 return Object.entries(m).sort((a,b)=>b[1]-a[1]).slice(0,n).map(x=>({key: x[0], n: x[1], p: x[1]/N}));
}

function normalize2(a, b){
 const s = a + b;
 if(!Number.isFinite(s) || s <= 0) return {A: 0.5, B: 0.5};
 return {A: a/s, B: b/s};
}

function seedRandom(v){ rngState = (Number(v)>>>0) || 1; }
function rnd(){ rngState = (1664525 * rngState + 1013904223)>>>0; return rngState / 4294967296; }

function poisson(lambda){
 lambda = Math.max(0, Number(lambda) || 0);
 if(lambda === 0) return 0;
 const L = Math.exp(-lambda);
 let p = 1, k = 0;
 do{ k++; p *= rnd(); }while(p > L && k < 1000);
 return k - 1;
}

function homeFactor(){
 const h = val("homeAdv");
 return h === null ? 1.03 : clamp(1 + h/100, .85, 1.20);
}

// --- ALGORITMO DE SIMULACIÓN POR FASES (ABRIDOR VS BULLPEN) ---
function mlbN(N){
 const rA = val("m_rA") ?? 4.6; const rB = val("m_rB") ?? 4.6;
 const raA = val("m_raA") ?? 4.4; const raB = val("m_raB") ?? 4.4;

 let baseA = 0.55 * rA + 0.45 * raB;
 let baseB = 0.55 * rB + 0.45 * raA;

 const opsA = val("m_opsA") ?? 0.720; const opsB = val("m_opsB") ?? 0.720;
 const opsDiff = clamp((opsA - opsB) / 0.8, -0.15, 0.15);
 baseA *= (1 + opsDiff * 0.4);
 baseB *= (1 - opsDiff * 0.4);

 const kA = val("m_kA") ?? 21; const kB = val("m_kB") ?? 21;
 const bbA = val("m_bbA") ?? 8; const bbB = val("m_bbB") ?? 8;
 baseA *= clamp(1 + ((bbA - kB) * 0.003), 0.90, 1.10);
 baseB *= clamp(1 + ((bbB - kA) * 0.003), 0.90, 1.10);

 // Fases de pitcheo: Abridor (Fase 1: 65% del peso en entradas 1-6) y Bullpen (Fase 2: 35% del peso en entradas 7-9)
 const manualEraA = val("altEraA");
 const manualEraB = val("altEraB");
 const effEraA = (manualEraA !== null && manualEraA > 0) ? manualEraA : (val("m_eraA") ?? 4.0);
 const effEraB = (manualEraB !== null && manualEraB > 0) ? manualEraB : (val("m_eraB") ?? 4.0);
 const bullA = val("m_bullA") ?? 4.0; const bullB = val("m_bullB") ?? 4.0;

 // Ponderación escalonada real
 const pitcherPhaseA = (effEraB * 0.65) + (bullB * 0.35);
 const pitcherPhaseB = (effEraA * 0.65) + (bullA * 0.35);

 let lambdaA = baseA * clamp(pitcherPhaseA / 4.2, 0.70, 1.35);
 let lambdaB = baseB * clamp(pitcherPhaseB / 4.2, 0.70, 1.35);

 lambdaA *= homeFactor();
 lambdaA = clamp(lambdaA, 0.5, 12);
 lambdaB = clamp(lambdaB, 0.5, 12);

 let A = 0, B = 0;
 const score = {}; const totals = {};
 let overCounts = {7.5: 0, 8.5: 0};
 let spreadACount = 0;

 for(let i = 0; i < N; i++){
  const a = poisson(lambdaA);
  const b = poisson(lambdaB);
  if(a > b) A++; else if(b > a) B++;
  else { if(rnd() < 0.5) A++; else B++; }

  if(a - b >= 2) spreadACount++;

  const tot = a + b;
  rec(score, `${a}-${b}`);
  rec(totals, String(tot));

  if(tot > 7.5) overCounts[7.5]++;
  if(tot > 8.5) overCounts[8.5]++;
 }

 const pMC = normalize2(A/N, B/N);

 return {
  sport: "MLB",
  a: nm("m_nombreA") || "Local",
  b: nm("m_nombreB") || "Visitante",
  N, seed: val("seed"),
  pMC, scoreTop: topN(score, N), totalsTop: topN(totals, N),
  spreadAProb: spreadACount/N,
  overs: {
   7.5: overCounts[7.5]/N,
   8.5: overCounts[8.5]/N
  },
  auditInfo: {
   eraAUsed: effEraA, isAltA: (manualEraA !== null && manualEraA > 0),
   eraBUsed: effEraB, isAltB: (manualEraB !== null && manualEraB > 0)
  }
 };
}

function renderPrediction(p){
 const oddsA = (1 / Math.max(0.1, p.pMC.A) * 0.92).toFixed(2);
 const oddsB = (1 / Math.max(0.1, p.pMC.B) * 0.92).toFixed(2);
 const oddsOver75 = (1 / Math.max(0.1, p.overs[7.5]) * 0.92).toFixed(2);
 const oddsUnder75 = (1 / Math.max(0.1, 1 - p.overs[7.5]) * 0.92).toFixed(2);

 let html = `
 <div class="result-grid">
 <div class="result"><b>${p.a} (Local)</b>${pct(p.pMC.A)}</div>
 <div class="result"><b>${p.b} (Visitante)</b>${pct(p.pMC.B)}</div>
 </div>
 `;

 html += `
 <div class="audit" style="border-left: 4px solid var(--purple)">
 <b>🔍 Auditoría del Modelo por Fases (Abridor + Bullpen):</b><br>
 • <b>Local (${p.a}):</b> ERA Abridor <b>${p.auditInfo.eraAUsed}</b> ${p.auditInfo.isAltA ? '<span class="warn-text">(⚠️ Manual)</span>' : '(✅ Oficial)'}<br>
 • <b>Visitante (${p.b}):</b> ERA Abridor <b>${p.auditInfo.eraBUsed}</b> ${p.auditInfo.isAltB ? '<span class="warn-text">(⚠️ Manual)</span>' : '(✅ Oficial)'}
 </div>
 `;

 html += `
 <div class="bet-card">
 <div class="bet-title">📊 Money Line (Ganador del Partido)</div>
 <div class="bet-grid">
  <div class="bet-option"><span>${p.a}</span><b>${oddsA}x</b></div>
  <div class="bet-option"><span>${p.b}</span><b>${oddsB}x</b></div>
 </div>
 </div>

 <div class="bet-card">
 <div class="bet-title">📈 Carreras Totales (Línea 7.5)</div>
 <div class="bet-grid">
  <div class="bet-option"><span>Over 7.5 (${pct(p.overs[7.5])})</span><b>${oddsOver75}x</b></div>
  <div class="bet-option"><span>Under 7.5 (${pct(1 - p.overs[7.5])})</span><b>${oddsUnder75}x</b></div>
 </div>
 </div>
 `;

 const diffProb = Math.abs(p.pMC.A - p.pMC.B);
 let safeTeam = "";
 let safeTeamProb = 0;
 
 if(diffProb < 0.05){
  safeTeam = p.pMC.A >= p.pMC.B ? `${p.a} (Hándicap Seguro +1.5)` : `${p.b} (Hándicap Seguro +1.5)`;
  safeTeamProb = Math.max(p.pMC.A, p.pMC.B) + 0.12;
 } else {
  safeTeam = p.pMC.A >= p.pMC.B ? `${p.a} (Money Line Sólido)` : `${p.b} (Money Line Sólido)`;
  safeTeamProb = Math.max(p.pMC.A, p.pMC.B);
 }

 const safeTotalText = p.overs[7.5] > 0.55 ? `Over 7.5 Carreras` : `Under 7.5 Carreras`;
 const safeTotalProb = p.overs[7.5] > 0.55 ? p.overs[7.5] : (1 - p.overs[7.5]);
 const estParlayOdd = (Number(oddsA) < Number(oddsB) ? Number(oddsA) : Number(oddsB)) * Number(oddsOver75);

 html += `
 <div class="parlay-box">
 <h3>🛡️ Parlay Algorítmico por Fases</h3>
 <p class="note" style="margin:4px 0 8px">Combinación equilibrada considerando el desgaste del abridor y el bullpen:</p>
 <ul>
  <li><b>Selección 1:</b> <span class="good">${safeTeam}</span> (Confianza: ${pct(safeTeamProb)})</li>
  <li><b>Selección 2:</b> <span class="good">${safeTotalText}</span> (Confianza: ${pct(safeTotalProb)})</li>
 </ul>
 <hr style="border:0;border-top:1px solid #4a2872;margin:8px 0">
 <div>• Cuota Combinada Estimada del Parlay: <b class="purple-text">@${estParlayOdd.toFixed(2)}x</b></div>
 </div>
 `;

 html += `<div class="audit" style="margin-top:10px"><b>Top 5 Marcadores más repetidos:</b><ol>` + p.scoreTop.slice(0,5).map(x=>`<li>${x.key} — ${x.p.toFixed(2)}%</li>`).join("") + `</ol></div>`;

 $("results").innerHTML = `<h2>Resultado — ${p.sport} (${p.N.toLocaleString()} sims)</h2>` + html;
}

$("run").onclick = () => {
 try{
  seedRandom(val("seed") || 20260930);
  const p = mlbN(Number($("sims").value));
  renderPrediction(p);
 }catch(e){
  $("results").innerHTML=`<div class="error"><b>Error:</b> ${e.message}</div>`;
 }
};

$("clear").onclick = () => {
 document.querySelectorAll("input").forEach(i => { if(i.id !== "seed" && i.id !== "homeAdv") i.value = ""; });
 $("selectA").value = ""; $("selectB").value = "";
 $("altEraA").value = ""; $("altEraB").value = "";
 $("results").innerHTML = `<h2>Resultado</h2><div class="note">Entradas limpiadas.</div>`;
};

initSelects();
</script>

</body>
</html>
