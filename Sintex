    <label style="font-size:10px">Escribe ERA manual (Opcional)</label>
    <input id="altEraA" type="number" step=".01" placeholder="Ej. 5.20">
  </div>
</div>

</div>
</div>

<!-- VISITANTE -->
<div class="team-panel visitor">
<div class="team-head"><h3>Equipo visitante</h3><span class="badge">VISITANTE</span></div>
<div class="metrics">
<div style="grid-column: span 2">
  <label>Seleccionar Equipo Oficial (Visitante)</label>
  <select id="selectB"><option value="">-- Elige un equipo --</option></select>
</div>
<div><label>Nombre</label><input id="m_nombreB"></div>
<div><label>Carreras / juego *</label><input id="m_rB" type="number" step=".01"></div>
<div><label>Carreras permitidas / juego</label><input id="m_raB" type="number" step=".01"></div>
<div><label>OPS</label><input id="m_opsB" type="number" step=".001"></div>
<div><label>HR / juego</label><input id="m_hrB" type="number" step=".01"></div>
<div><label>K%</label><input id="m_kB" type="number" step=".1"></div>
<div><label>BB%</label><input id="m_bbB" type="number" step=".1"></div>
<div><label>ERA abridor base</label><input id="m_eraB" type="number" step=".01"></div>
<div><label>ERA bullpen</label><input id="m_bullB" type="number" step=".01"></div>
<div><label>Defensa</label><input id="m_defB" type="number" step=".01"></div>

<div class="alt-pitcher-box">
  <label class="warn-text">⚠️ Abridor Alternativo / Manual (Visitante)</label>
  <div style="margin-top:4px">
    <label style="font-size:10px">Escribe ERA manual (Opcional)</label>
    <input id="altEraB" type="number" step=".01" placeholder="Ej. 4.80">
  </div>
</div>

</div>
</div>

</div>
</section>

<section id="results" class="results">
<h2>Resultado de la Simulación por Fases</h2>
<div class="note">Aún no se ha ejecutado una simulación.</div>
</section>

</div>

<script>
"use strict";

const MLB_DATA = [
